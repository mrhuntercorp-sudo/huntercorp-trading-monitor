{
  "name": "huntercorp-trading-monitor",
  "version": "0.1.0",
  "private": true,
  "description": "TM001 NQ strategy research and trading intelligence monitor",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts",
    "smoke:massive": "node --env-file=.env --import tsx src/scripts/massive-smoke.ts",
    "quality:massive": "node --env-file=.env --import tsx src/scripts/massive-quality.ts",
    "features:massive": "node --env-file=.env --import tsx src/scripts/massive-features.ts",
    "benchmark:orb": "node --env-file=.env --import tsx src/scripts/massive-orb-benchmark.ts",
    "benchmark:orb10": "node --env-file=.env --import tsx src/scripts/massive-orb-ten.ts",
    "diagnose:orb10": "node --env-file=.env --import tsx src/scripts/massive-orb-diagnostics.ts",
    "audit:contracts": "node --env-file=.env --import tsx src/scripts/massive-contract-audit.ts",
    "audit:rollover-volume": "node --env-file=.env --import tsx src/scripts/massive-rollover-volume.ts",
    "audit:rollover-gap": "node --import tsx src/scripts/massive-rollover-gap-audit.ts",
    "audit:rollover-decision": "node --import tsx src/scripts/massive-rollover-decision-audit.ts",
    "audit:sparse-minutes": "node --import tsx src/scripts/massive-sparse-minute-audit.ts",
    "audit:multi-rollover": "node --env-file=.env --import tsx src/scripts/massive-multi-rollover.ts",
    "audit:rollover-continuity": "node --import tsx src/scripts/massive-rollover-continuity-audit.ts",
    "study:rollover-adjustment": "node --import tsx src/scripts/massive-rollover-adjustment-study.ts",
    "study:rollover-signals": "node --import tsx src/scripts/massive-rollover-signal-integrity.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
